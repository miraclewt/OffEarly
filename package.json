{
  "name": "offearly",
  "private": true,
  "license": "MIT",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint:emoji": "node scripts/no-emoji.mjs",
    "verify": "node scripts/verify-bundle.mjs",
    "build": "npm run lint:emoji && tsc --noEmit && vite build && npm run verify",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "capture": "playwright test --config playwright.capture.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dayjs": "1.11.23",
    "mermaid": "^12.2.0",
    "nanoid": "6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "5.0.4"
  }
}
